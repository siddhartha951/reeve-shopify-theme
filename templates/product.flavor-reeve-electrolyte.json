          "type": "ingredient",
          "settings": {
            "name": "Chloride 760mg",
            "tags": "Absorption, Digestion",
            "description": "Sodium's partner. The two move together, which is why chloride is the biggest number on the label even though nobody talks about it."
          }
        },
        "ing_2": {
          "type": "ingredient",
          "settings": {
            "name": "Potassium 200mg",
            "tags": "Balance, Muscle function",
            "description": "Sits on the other side of the cell membrane from sodium. Contributes to normal muscle function and the maintenance of normal blood pressure."
          }
        },
