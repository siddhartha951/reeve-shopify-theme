{%- comment -%}
  Blint product showcase — 50/50 split PDP layout (vertical thumbnail rail +
  tall main image with a floating review card on the left, plain content
  column on the right: meta row, title, subtitle, description, purchase-type
  cards, quantity + add to cart) plus full-width upsell / accordion /
  ingredients rows and a lightweight sticky add-to-cart bar.

  Purchasing engine (variant/plan resolution, quantity tiers, box pricing
  cards, cross-product flavor linking, sticky bar) is a direct port of the
  proven data-attribute-driven script from blint-product-custom-ab.liquid —
  same JSON payload shape, same data-* hooks — only the surrounding markup
  and CSS are new.
{%- endcomment -%}
{%- liquid
  comment
    On an actual product page, always show that page's own product — never the
    hardcoded setting. The setting only matters as a fallback when this
    section is placed somewhere without page context.
  endcomment
  assign product = product | default: section.settings.selected_product
  assign current_variant = product.selected_or_first_available_variant

  assign purchase_block = nil
  assign flavor_block = nil
  assign featured_review_block = nil
  assign upsell_heading_block = nil
  assign ingredients_heading_block = nil
  assign upsell_items = section.blocks | where: 'type', 'upsell_item'
  assign accordion_items = section.blocks | where: 'type', 'accordion_item'
  assign ingredient_items = section.blocks | where: 'type', 'ingredient_item'

  for block in section.blocks
    case block.type
      when 'purchase_cards'
        assign purchase_block = block
      when 'flavor'
        assign flavor_block = block
      when 'featured_review'
        assign featured_review_block = block
      when 'upsell_heading'
        assign upsell_heading_block = block
      when 'ingredients_heading'
        assign ingredients_heading_block = block
    endcase
  endfor

  assign sp_group = product.selling_plan_groups | first
  assign sp = nil
  if sp_group
    assign sp = sp_group.selling_plans | first
    if purchase_block.settings.default_frequency_name != blank
      for plan in sp_group.selling_plans
        if plan.name == purchase_block.settings.default_frequency_name
          assign sp = plan
          break
        endif
      endfor
    endif
  endif
  assign default_subscribe = false
  if sp and purchase_block.settings.default_to_subscription
    assign default_subscribe = true
  endif

  comment
    Flavors are linked as separate products via a metafield (same contract as
    blint-product-custom-ab.liquid), so "fetching what's already set up via
    metafields" carries over unchanged.
  endcomment
  assign linked_flavors = blank
  assign select_label = ''
  if flavor_block.settings.enable_flavor_select
    assign linked_flavors = product.metafields.custom.custom_flavor_products.value
  endif
  if linked_flavors != blank
    assign self_in_list = false
    for f in linked_flavors
      if f.id == product.id
        assign self_in_list = true
      endif
    endfor
    assign other_flavor_count = linked_flavors.size
    if self_in_list
      assign other_flavor_count = other_flavor_count | minus: 1
    endif
    assign flavor_count = other_flavor_count | plus: 1
    assign select_label = flavor_block.settings.select_flavors_label | replace: '[count]', flavor_count
  endif
-%}

<section
  class="blint-showcase spacing-style color-{{ section.settings.color_scheme }}{% if section.settings.enable_glass_cards %} blint-showcase--glass{% endif %}{% if section.settings.background_image != blank %} blint-showcase--has-bg{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %} --blint-bg-overlay-opacity: {{ section.settings.background_overlay_opacity | default: 45 | times: 1.0 | divided_by: 100 }};"
  data-blint-product
  data-money-format="{{ shop.money_format | escape }}"
  data-pack-static="{{ purchase_block.settings.pack_size_label | escape }}"
  {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
>
  {%- if section.settings.background_image != blank -%}
    <div class="blint-showcase__bg" data-blint-bg-image aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 1920', class: 'blint-showcase__bg-image'
      }}
      <div class="blint-showcase__bg-overlay"></div>
    </div>
  {%- endif -%}

  <div class="blint-showcase__layout">
    {%- comment -%} ---------- Gallery: vertical thumb rail + tall main image ---------- {%- endcomment -%}
    <div class="blint-showcase__gallery">
      {%- if product.media.size > 1 -%}
        <div class="blint-showcase__thumbs" role="list">
          {%- for media in product.media -%}
            <button
              type="button"
              class="blint-showcase__thumb{% if forloop.first %} is-active{% endif %}"
              data-thumb
              data-media-id="{{ media.id }}"
              data-full="{{ media | image_url: width: 1400 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{ media | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', alt: media.alt | default: product.title | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="blint-showcase__main">
        {%- if current_variant.featured_media != blank -%}
          {%- assign main_media = current_variant.featured_media -%}
        {%- else -%}
          {%- assign main_media = product.featured_media -%}
        {%- endif -%}
        {%- if main_media != blank -%}
          {{
            main_media
            | image_url: width: 1400
            | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 750, 1000, 1400', class: 'blint-product__main-image blint-showcase__main-image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'blint-product__main-image blint-showcase__main-image' }}
        {%- endif -%}

        {%- if featured_review_block and featured_review_block.settings.show_review and featured_review_block.settings.review_text != blank -%}
          <div class="blint-showcase__review-card" data-review-card {{ featured_review_block.shopify_attributes }}>
            <div class="blint-showcase__review-stars" aria-hidden="true">
              {%- assign filled = featured_review_block.settings.review_rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <span class="{% if i <= filled %}is-filled{% endif %}">&#9733;</span>
              {%- endfor -%}
            </div>
            <p class="blint-showcase__review-text">{{ featured_review_block.settings.review_text }}</p>
            {%- if featured_review_block.settings.product_label != blank or featured_review_block.settings.review_rating != blank -%}
              <p class="blint-showcase__review-meta">
                {%- if featured_review_block.settings.product_label != blank -%}
                  <span>Product: {{ featured_review_block.settings.product_label }}</span>
                {%- endif -%}
                <span>Rating: {{ filled }}/5</span>
              </p>
            {%- endif -%}
            {%- if featured_review_block.settings.reviewer_name != blank -%}
              <p class="blint-showcase__review-name">{{ featured_review_block.settings.reviewer_name }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- Content column ---------- {%- endcomment -%}
    <div class="blint-showcase__content">
      {%- form 'product', product, id: 'blint-product-form', class: 'blint-showcase__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="selling_plan" value="{% if default_subscribe %}{{ sp.id }}{% endif %}" data-selling-plan {% unless default_subscribe %}disabled{% endunless %}>
        <input type="hidden" name="return_to" value="/checkout">

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'meta_row' -%}
              <div class="blint-showcase__meta" {{ block.shopify_attributes }}>
                <div class="blint-showcase__meta-left">
                  {%- if block.settings.show_flavor_badge -%}
                    {%- assign flavor_display = block.settings.flavor_badge_label -%}
                    {%- if flavor_display == blank -%}
                      {%- for option in product.options_with_values -%}
                        {%- assign name_down = option.name | downcase -%}
                        {%- unless name_down contains 'count' or name_down contains 'can' or name_down contains 'pack' or name_down contains 'size' or name_down contains 'quantity' or name_down contains 'qty' -%}
                          {%- assign flavor_display = option.selected_value -%}
                          {%- break -%}
                        {%- endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {%- if flavor_display != blank -%}
                      <span class="blint-showcase__badge">{{ flavor_display }}</span>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.weight_text != blank -%}
                    <span class="blint-showcase__weight">{{ block.settings.weight_text }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_rating and block.settings.rating_value != blank -%}
                  <a
                    {% if block.settings.reviews_anchor != blank %}href="{{ block.settings.reviews_anchor }}"{% else %}href="#"{% endif %}
                    class="blint-showcase__rating"
                  >
                    <span class="blint-showcase__rating-stars" aria-hidden="true">
                      {%- for i in (1..5) -%}<span>&#9733;</span>{%- endfor -%}
                    </span>
                    <span class="blint-showcase__rating-count">{{ block.settings.rating_count }}</span>
                  </a>
                {%- endif -%}
              </div>
              {%- if block.settings.show_availability -%}
                <p
                  class="blint-showcase__availability"
                  data-availability
                  data-in-stock-label="{{ block.settings.in_stock_label | escape }}"
                  data-oos-label="{{ block.settings.out_of_stock_label | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <span class="blint-showcase__availability-dot" aria-hidden="true"></span>
                  <span data-availability-label>{% if current_variant.available %}{{ block.settings.in_stock_label }}{% else %}{{ block.settings.out_of_stock_label }}{% endif %}</span>
                </p>
              {%- endif -%}

            {%- when 'title' -%}
              {%- if block.settings.title_override != blank -%}
                <h1 class="blint-showcase__title" style="--blint-showcase-title-size: {{ block.settings.title_font_size }}px;" {{ block.shopify_attributes }}>{{ block.settings.title_override }}</h1>
              {%- else -%}
                <h1 class="blint-showcase__title" style="--blint-showcase-title-size: {{ block.settings.title_font_size }}px;" {{ block.shopify_attributes }}>{{ product.title }}</h1>
              {%- endif -%}

            {%- when 'subtitle' -%}
              {%- if block.settings.subtitle_text != blank -%}
                <p class="blint-showcase__subtitle" {{ block.shopify_attributes }}>{{ block.settings.subtitle_text }}</p>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if block.settings.description != blank -%}
                <div class="blint-showcase__desc" {{ block.shopify_attributes }}>{{ block.settings.description }}</div>
              {%- elsif product.description != blank -%}
                <div class="blint-showcase__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'note_text' -%}
              {%- if block.settings.note != blank -%}
                <div class="blint-showcase__note" {{ block.shopify_attributes }}>{{ block.settings.note }}</div>
              {%- endif -%}

            {%- when 'boxes' -%}
              <div class="blint-showcase__options" {{ block.shopify_attributes }}>
                {%- render 'blint-product-options', product: product, block: block -%}
              </div>

            {%- when 'flavor' -%}
              {%- if linked_flavors != blank -%}
                <div class="blint-showcase__flavor" {{ block.shopify_attributes }}>
                  <p class="blint-showcase__option-name">{{ block.settings.flavor_switch_heading }}</p>
                  <div class="blint-showcase__flavor-switch" data-flavor-switch role="list">
                    <a href="{{ product.url }}" class="blint-showcase__flavor-card is-active" aria-current="true">
                      {%- if product.featured_image != blank -%}
                        {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', alt: product.title | escape }}
                      {%- endif -%}
                      <span>{{ product.title | truncate: 22 }}</span>
                    </a>
                    {%- for flavor in linked_flavors -%}
                      {%- unless flavor.id == product.id -%}
                        <a href="{{ flavor.url }}" class="blint-showcase__flavor-card" data-flavor-link>
                          {%- if flavor.featured_image != blank -%}
                            {{ flavor.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', alt: flavor.title | escape }}
                          {%- endif -%}
                          <span>{{ flavor.title | truncate: 22 }}</span>
                        </a>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'purchase_cards' -%}
              <div class="blint-showcase__purchase" data-purchase-group {{ block.shopify_attributes }}>
                <label class="blint-showcase__card">
                  <input type="radio" name="blint-purchase" value="onetime" data-purchase-input {% unless default_subscribe %}checked{% endunless %}>
                  <span class="blint-showcase__card-head">
                    <span class="blint-showcase__card-radio" aria-hidden="true"></span>
                    <span class="blint-showcase__card-label">{{ block.settings.onetime_label }}</span>
                  </span>
                  <span class="blint-showcase__pack-badge" data-pack-badge hidden></span>
                  <span class="blint-showcase__card-unit" data-onetime-unit hidden></span>
                  {%- if block.settings.onetime_note != blank -%}
                    <span class="blint-showcase__card-note">{{ block.settings.onetime_note }}</span>
                  {%- endif -%}
                  <span class="blint-showcase__card-price" data-onetime-price></span>
                </label>

                {%- if sp -%}
                  <label class="blint-showcase__card blint-showcase__card--sub">
                    <input type="radio" name="blint-purchase" value="subscribe" data-purchase-input data-plan="{{ sp.id }}" {% if default_subscribe %}checked{% endif %}>
                    <span class="blint-showcase__card-head">
                      <span class="blint-showcase__card-radio" aria-hidden="true"></span>
                      <span class="blint-showcase__card-label">{{ block.settings.subscribe_label }}<span data-sub-pct></span></span>
                    </span>
                    <span class="blint-showcase__pack-badge blint-showcase__pack-badge--accent" data-pack-badge hidden></span>
                    <span class="blint-showcase__card-unit" data-sub-unit hidden></span>
                    {%- if block.settings.sub_note_right != blank -%}
                      <span class="blint-showcase__card-note">{{ block.settings.sub_note_right }}</span>
                    {%- endif -%}

                    <span class="blint-showcase__frequency" data-frequency-wrap{% unless default_subscribe %} hidden{% endunless %}>
                      <label class="blint-showcase__frequency-label" for="blint-frequency-{{ section.id }}">{{ block.settings.frequency_label }}</label>
                      <span class="blint-showcase__frequency-control">
                        <select id="blint-frequency-{{ section.id }}" class="blint-showcase__frequency-select" data-frequency aria-label="{{ block.settings.frequency_label | escape }}">
                          {%- for plan in sp_group.selling_plans -%}
                            <option value="{{ plan.id }}"{% if plan.id == sp.id %} selected{% endif %}>{{ plan.name }}</option>
                          {%- endfor -%}
                        </select>
                        <span class="blint-showcase__frequency-caret" aria-hidden="true">&#9662;</span>
                      </span>
                    </span>

                    <span class="blint-showcase__card-price">
                      <span class="blint-showcase__card-compare" data-sub-compare hidden></span>
                      <span data-sub-price></span>
                    </span>
                  </label>
                {%- endif -%}
              </div>

            {%- when 'quantity_atc' -%}
              <div class="blint-showcase__buy-row" {{ block.shopify_attributes }}>
                <div class="blint-showcase__qty">
                  <button type="button" class="blint-showcase__qty-btn" data-qty-minus aria-label="Decrease quantity">&#8722;</button>
                  <input type="text" name="quantity" value="1" class="blint-showcase__qty-input" data-qty-input inputmode="numeric" aria-label="Quantity">
                  <button type="button" class="blint-showcase__qty-btn" data-qty-plus aria-label="Increase quantity">&#43;</button>
                </div>
                <button
                  type="submit"
                  class="blint-showcase__atc"
                  data-atc
                  {% if linked_flavors != blank %}data-select-flavors{% endif %}
                  style="--blint-cta: {{ block.settings.cta_color }}; --blint-cta-text: {{ block.settings.cta_text_color }};"
                >
                  <span data-atc-label>{% if linked_flavors != blank %}{{ select_label }}{% else %}{{ block.settings.atc_label }}{% endif %}</span>
                  <span data-atc-price></span>
                </button>
              </div>
              {%- assign guarantees = block.settings.guarantees | split: ',' -%}
              {%- if block.settings.guarantees != blank -%}
                <ul class="blint-showcase__guarantees" role="list">
                  {%- for g in guarantees -%}
                    {%- assign g_clean = g | strip -%}
                    {%- if g_clean != blank -%}
                      <li class="blint-showcase__guarantee">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>{{ g_clean }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}

        <script type="application/json" data-blint-variants>
          {
            "variants": [
              {%- for v in product.variants -%}
                {
                  "id": {{ v.id }},
                  "available": {{ v.available }},
                  "options": {{ v.options | json }},
                  "price": {{ v.price }},
                  "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
                  "media_id": {{ v.featured_media.id | default: 0 | json }},
                  "plans": [
                    {%- for a in v.selling_plan_allocations -%}
                      { "id": {{ a.selling_plan.id }}, "price": {{ a.price }}, "compare_at_price": {{ a.compare_at_price | default: 0 | json }} }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endform -%}
    </div>
  </div>

  {%- comment -%} ---------- Full-width rows: upsell / accordions / ingredients ---------- {%- endcomment -%}
  <div class="blint-showcase__below">
    {%- if upsell_items.size > 0 -%}
      <div class="blint-showcase__upsell">
        {%- if upsell_heading_block.settings.heading != blank -%}
          <p class="blint-showcase__upsell-heading">{{ upsell_heading_block.settings.heading }}</p>
        {%- endif -%}
        <div class="blint-showcase__upsell-track">
          {%- for block in upsell_items -%}
            {%- assign up_product = block.settings.product -%}
            {%- if up_product != blank -%}
              <div class="blint-showcase__upsell-card" data-upsell-card data-variant-id="{{ up_product.selected_or_first_available_variant.id }}" {{ block.shopify_attributes }}>
                <div class="blint-showcase__upsell-media">
                  {%- if up_product.featured_image != blank -%}
                    {{ up_product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', alt: up_product.title | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="blint-showcase__upsell-body">
                  <p class="blint-showcase__upsell-title">{{ up_product.title }}</p>
                  {%- if block.settings.subtitle != blank -%}
                    <p class="blint-showcase__upsell-subtitle">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                  <button type="button" class="blint-showcase__upsell-add" data-upsell-add aria-label="Add {{ up_product.title | escape }} to cart">
                    <span data-upsell-add-icon>&#43;</span>
                  </button>
                  <span class="blint-showcase__upsell-price">{{ up_product.price | money }}</span>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if accordion_items.size > 0 -%}
      <div class="blint-showcase__accordions">
        {%- for block in accordion_items -%}
          <div {{ block.shopify_attributes }}>
            {%- render 'blint-accordion-item', heading: block.settings.heading, content: block.settings.content, open: block.settings.open_by_default -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if ingredient_items.size > 0 -%}
      <div class="blint-showcase__ingredients">
        {%- if ingredients_heading_block.settings.heading != blank -%}
          <p class="blint-showcase__ingredients-heading">{{ ingredients_heading_block.settings.heading }}</p>
        {%- endif -%}
        <div class="blint-showcase__ing-wrap">
          <div class="blint-showcase__ing-track" data-ing-track>
            {%- for block in ingredient_items -%}
              {%- assign ing_alt = block.settings.name | escape -%}
              <article class="blint-showcase__ing-card" {{ block.shopify_attributes }}>
                <div class="blint-showcase__ing-media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', alt: ing_alt, class: 'blint-showcase__ing-image' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'blint-showcase__ing-image' }}
                  {%- endif -%}
                </div>
                <div class="blint-showcase__ing-body">
                  {%- if block.settings.name != blank -%}<h3 class="blint-showcase__ing-name">{{ block.settings.name }}</h3>{%- endif -%}
                  {%- if block.settings.description != blank -%}<p class="blint-showcase__ing-desc">{{ block.settings.description }}</p>{%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
          <span class="blint-showcase__ing-drag" data-ing-drag aria-hidden="true">Drag</span>
        </div>
        {%- if ingredients_heading_block.settings.full_list != blank -%}
          <details class="blint-showcase__full-list">
            <summary>
              <span data-full-list-show>Show full list</span>
              <span data-full-list-hide hidden>Hide full list</span>
            </summary>
            <p>{{ ingredients_heading_block.settings.full_list }}</p>
          </details>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Lightweight sticky add-to-cart ---------- {%- endcomment -%}
  {%- if section.settings.enable_sticky_atc -%}
    <div class="blint-showcase__sticky" data-sticky aria-hidden="true">
      <div class="blint-showcase__sticky-inner">
        {%- if main_media != blank -%}
          <span class="blint-showcase__sticky-thumb">{{ main_media | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}</span>
        {%- endif -%}
        <span class="blint-showcase__sticky-title">{{ product.title }}</span>
        <button
          type="button"
          class="blint-showcase__atc blint-showcase__sticky-btn"
          data-sticky-atc
          {% if linked_flavors != blank %}data-select-flavors{% endif %}
        >
          <span data-sticky-label>{% if linked_flavors != blank %}{{ select_label }}{% else %}Add to cart{% endif %}</span>
          <span data-sticky-price></span>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .blint-showcase {
    position: relative;
  }

  /* Background image + overlay (optional) */
  .blint-showcase__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .blint-showcase__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    will-change: transform;
  }
  .blint-showcase__bg-overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--blint-bg-overlay-opacity, 0.45));
