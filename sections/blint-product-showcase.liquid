<script>
  (function () {
    const script = document.currentScript;
    const scope = (script && script.closest('.shopify-section')) || document;
    const root = scope.querySelector('[data-blint-product]');
    if (!root) return;

    import('@theme/motion').then(function (mod) {
      const gsap = mod.gsap;
      const ScrollTrigger = mod.ScrollTrigger;
      const prefersReducedMotion = mod.prefersReducedMotion;

      const gallery = root.querySelector('.blint-showcase__gallery');
      const content = root.querySelector('.blint-showcase__content');
      const reviewCard = root.querySelector('[data-review-card]');
      const bg = root.querySelector('[data-blint-bg-image]');
      const upsellCards = root.querySelectorAll('.blint-showcase__upsell-card');
      const ingredientCards = root.querySelectorAll('.blint-showcase__ing-card');
      const dragHint = root.querySelector('[data-ing-drag]');
      const ingTrack = root.querySelector('[data-ing-track]');
      const purchaseCards = root.querySelectorAll('.blint-showcase__card');
      const stickyBar = root.querySelector('[data-sticky]');

      if (prefersReducedMotion()) {
        gsap.set([gallery, content, reviewCard].filter(Boolean), { opacity: 1, y: 0, scale: 1 });
        gsap.set(Array.from(upsellCards).concat(Array.from(ingredientCards)), { opacity: 1, y: 0 });
        return;
      }

      if (gallery && content) {
        gsap.set([gallery, content], { opacity: 0, y: 40 });
        ScrollTrigger.batch([gallery, content], {
          start: 'top 88%',
          once: true,
          onEnter: function (batch) {
            gsap.to(batch, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.15 });
          },
        });
      }

      if (reviewCard) {
        gsap.set(reviewCard, { opacity: 0, y: 20, scale: 0.94 });
        gsap.to(reviewCard, { opacity: 1, y: 0, scale: 1, duration: 0.8, ease: 'back.out(1.6)', delay: 0.5 });
        gsap.to(reviewCard, { y: '+=8', duration: 2.6, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 1.3 });
      }

      if (bg) {
        const image = bg.querySelector('.blint-showcase__bg-image');
        if (image) {
          gsap.fromTo(
            image,
            { yPercent: -6, scale: 1.1 },
            { yPercent: 6, scale: 1.1, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } }
          );
        }
      }

      if (upsellCards.length) {
        gsap.set(upsellCards, { opacity: 0, y: 24 });
        ScrollTrigger.batch(upsellCards, {
          start: 'top 92%',
          once: true,
          onEnter: function (batch) { gsap.to(batch, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.08 }); },
        });
      }

      if (ingredientCards.length) {
        gsap.set(ingredientCards, { opacity: 0, y: 24 });
        ScrollTrigger.batch(ingredientCards, {
          start: 'top 92%',
          once: true,
          onEnter: function (batch) { gsap.to(batch, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.08 }); },
        });
      }

      if (dragHint) {
        gsap.to(dragHint, { y: '+=6', duration: 1.1, ease: 'sine.inOut', yoyo: true, repeat: -1 });
        if (ingTrack) {
          const hide = function () {
            gsap.to(dragHint, { opacity: 0, duration: 0.3, onComplete: function () { dragHint.classList.add('is-hidden'); } });
            ingTrack.removeEventListener('scroll', hide);
            ingTrack.removeEventListener('pointerdown', hide);
          };
          ingTrack.addEventListener('scroll', hide, { once: true });
          ingTrack.addEventListener('pointerdown', hide, { once: true });
        }
      }

      purchaseCards.forEach(function (card) {
        const input = card.querySelector('input');
        if (!input) return;
        input.addEventListener('change', function () {
          if (!input.checked) return;
          gsap.fromTo(card, { scale: 0.97 }, { scale: 1, duration: 0.25, ease: 'back.out(2)' });
        });
      });

      if (stickyBar) {
        gsap.set(stickyBar, { yPercent: 100, opacity: 0 });
        const mo = new MutationObserver(function () {
          const visible = stickyBar.classList.contains('is-visible');
          gsap.to(stickyBar, { yPercent: visible ? 0 : 100, opacity: visible ? 1 : 0, duration: 0.35, ease: 'power2.out' });
        });
        mo.observe(stickyBar, { attributes: true, attributeFilter: ['class'] });
      }

      const atc = root.querySelector('[data-atc]');
      if (stickyBar && atc && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            stickyBar.classList.toggle('is-visible', !entry.isIntersecting);
            stickyBar.setAttribute('aria-hidden', entry.isIntersecting ? 'true' : 'false');
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        observer.observe(atc);
      }
    });
  })();
</script>

