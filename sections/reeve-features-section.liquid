      "default": "SIX REASONS REEVÉ WORKS"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Built around what your body actually loses</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph",
