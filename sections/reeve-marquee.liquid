{% comment %}
  Reeve Marquee — infinite scrolling text/image ticker for Horizon theme
  Section handle: reeve-marquee
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign items = section.blocks
  assign section_id = section.id

  assign separator_char = ''
  case s.separator_style
    when 'dot'
      assign separator_char = '•'
    when 'pipe'
      assign separator_char = '|'
    when 'star'
      assign separator_char = '★'
    when 'diamond'
      assign separator_char = '◆'
    when 'custom'
      assign separator_char = s.separator_custom_text
  endcase
-%}

<section
  class="reeve-marquee{% if s.text_bold %} reeve-marquee--bold{% endif %}{% if s.text_uppercase %} reeve-marquee--uppercase{% endif %}"
  data-section-id="{{ section_id }}"
  data-direction="{{ s.scroll_direction }}"
  data-pause-on-hover="{{ s.pause_on_hover }}"
  style="
    --rmq-bg: {{ s.background_color }};
    --rmq-text: {{ s.text_color }};
    --rmq-separator: {{ s.separator_color }};
    --rmq-border-color: {{ s.border_color }};
    --rmq-border-width: {{ s.border_width }}px;
    --rmq-gap: {{ s.item_gap }}px;
    --rmq-image-height: {{ s.image_height }}px;
    --rmq-text-size-desktop: {{ s.text_size_desktop }}px;
    --rmq-text-size-mobile: {{ s.text_size_mobile }}px;
    --rmq-letter-spacing: {{ s.letter_spacing | default: 0 | times: 1.0 | divided_by: 100 }}em;
    --rmq-speed: {{ s.scroll_speed }}s;
    --rmq-padding-top: {{ s.padding_top }}px;
    --rmq-padding-bottom: {{ s.padding_bottom }}px;
  "
>
  {%- if items.size > 0 -%}
    <div class="reeve-marquee__viewport">
      <div class="reeve-marquee__track" data-rmq-track>
        {%- for copy_index in (1..2) -%}
          <div class="reeve-marquee__group" aria-hidden="{% unless forloop.first %}true{% endunless %}">
            {%- for block in items -%}
              <div class="reeve-marquee__item" {{ block.shopify_attributes }}>
                {%- case block.type -%}
                  {%- when 'text_item' -%}
                    {%- if block.settings.text != blank -%}
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="reeve-marquee__text reeve-marquee__link">{{ block.settings.text }}</a>
                      {%- else -%}
                        <span class="reeve-marquee__text">{{ block.settings.text }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- when 'image_item' -%}
                    {%- if block.settings.image != blank -%}
                      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="reeve-marquee__link">{%- endif -%}
                      {{
                        block.settings.image
                        | image_url: width: 400
                        | image_tag: loading: 'lazy', class: 'reeve-marquee__image'
                      }}
                      {%- if block.settings.link != blank -%}</a>{%- endif -%}
                    {%- endif -%}
                {%- endcase -%}
              </div>
              {%- if separator_char != blank -%}
                <div class="reeve-marquee__separator" aria-hidden="true">{{ separator_char }}</div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .reeve-marquee {
    position: relative;
    background: var(--rmq-bg, #10192b);
    color: var(--rmq-text, #ffffff);
    padding-top: var(--rmq-padding-top, 14px);
    padding-bottom: var(--rmq-padding-bottom, 14px);
    border-top: var(--rmq-border-width, 0px) solid var(--rmq-border-color, transparent);
    border-bottom: var(--rmq-border-width, 0px) solid var(--rmq-border-color, transparent);
    overflow: hidden;
  }

  .reeve-marquee__viewport {
    width: 100%;
    overflow: hidden;
  }

  .reeve-marquee__track {
    display: flex;
    width: max-content;
    animation: reeve-marquee-scroll var(--rmq-speed, 25s) linear infinite;
  }

  .reeve-marquee[data-direction='right'] .reeve-marquee__track {
    animation-direction: reverse;
  }

  .reeve-marquee[data-pause-on-hover='true']:hover .reeve-marquee__track {
    animation-play-state: paused;
  }

  .reeve-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--rmq-gap, 32px);
    padding-inline-end: var(--rmq-gap, 32px);
  }

  .reeve-marquee__item {
    display: flex;
    align-items: center;
  }

  .reeve-marquee__text {
    font-family: var(--font-body--family);
    font-size: var(--rmq-text-size-mobile, 14px);
    letter-spacing: var(--rmq-letter-spacing, 0);
    color: var(--rmq-text, inherit);
    white-space: nowrap;
    text-decoration: none;
  }

  .reeve-marquee--bold .reeve-marquee__text {
    font-weight: 700;
  }

  .reeve-marquee--uppercase .reeve-marquee__text {
    text-transform: uppercase;
  }

  .reeve-marquee__link:hover {
    text-decoration: underline;
  }

  .reeve-marquee__image {
    height: var(--rmq-image-height, 32px);
    width: auto;
    max-width: none;
    display: block;
    object-fit: contain;
  }

  .reeve-marquee__separator {
    flex-shrink: 0;
    color: var(--rmq-separator, currentColor);
    opacity: 0.6;
    font-size: var(--rmq-text-size-mobile, 14px);
    line-height: 1;
  }

  @keyframes reeve-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media screen and (min-width: 750px) {
    .reeve-marquee__text,
    .reeve-marquee__separator {
      font-size: var(--rmq-text-size-desktop, 16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reeve-marquee__track {
      animation: none;
    }

    .reeve-marquee__viewport {
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .reeve-marquee__group[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reeve Marquee",
  "tag": "section",
  "class": "reeve-marquee-section",
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "info": "Seconds for one full loop. Lower is faster.",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 25
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "dot", "label": "Dot (•)" },
        { "value": "pipe", "label": "Pipe (|)" },
        { "value": "star", "label": "Star (★)" },
        { "value": "diamond", "label": "Diamond (◆)" },
        { "value": "custom", "label": "Custom text" }
      ],
      "default": "dot"
    },
    {
      "type": "text",
      "id": "separator_custom_text",
      "label": "Custom separator text",
      "info": "Used when separator style above is \"Custom text\".",
      "visible_if": "{{ section.settings.separator_style == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size (desktop)",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size (mobile)",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "text_bold",
      "label": "Bold text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "text_uppercase",
      "label": "Uppercase text",
      "default": true
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "info": "In hundredths of an em — e.g. 2 = 0.02em.",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Sizing & spacing"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items",
      "min": 8,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#10192b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border (top & bottom)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on all orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    },
    {
      "type": "image_item",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reeve Marquee",
      "blocks": [
        { "type": "text_item", "settings": { "text": "Free Shipping On All Orders" } },
        { "type": "text_item", "settings": { "text": "Zero Sugar. Zero Fillers." } },
        { "type": "text_item", "settings": { "text": "6 Electrolytes. One Smarter Formula." } },
        { "type": "text_item", "settings": { "text": "30-Day Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
