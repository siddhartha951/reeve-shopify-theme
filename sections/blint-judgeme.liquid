<div
  class="blint-judgeme spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %} --heading-size: {{ section.settings.heading_font_size }}px; --blint-jm-title: {{ section.settings.review_title_size | default: 15 }}px; --blint-jm-body: {{ section.settings.review_text_size | default: 14 }}px; --blint-jm-star: {{ section.settings.star_size | default: 16 }}px;"
  {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
>
  <div class="blint-judgeme__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="blint-judgeme__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</div>

{% stylesheet %}
  .blint-judgeme__inner {
    max-width: var(--page-width, 1500px);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }

  .blint-judgeme__heading {
    margin: 0 0 1.5rem;
    font-family: var(--blint-heading-font, 'Titillium Web', sans-serif);
    font-weight: var(--blint-heading-weight, 700);
    font-size: min(var(--heading-size, 48px), 11vw);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  /* The Judge.me widget's own type scale lives in assets/judgeme-typography.css,
     loaded globally, so it also reaches Judge.me app blocks placed on templates
     where this section isn't present. The three --blint-jm-* variables in this
     section's inline style feed that stylesheet for this instance. */
{% endstylesheet %}

{% schema %}
{
  "name": "Blint reviews (Judge.me)",
  "tag": "section",
  "class": "blint-judgeme-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays the Judge.me product review widget. Make sure the Judge.me app is installed and its app embed is enabled (Theme settings → App embeds)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Review typography"
    },
    {
      "type": "paragraph",
      "content": "Rescales the Judge.me widget's text. Judge.me also has its own Small\/Medium\/Large presets under Review widget → Review → Styling — set those first if you have the Awesome plan; these settings override the result."
    },
    {
      "type": "range",
      "id": "review_title_size",
      "label": "Review title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "review_text_size",
      "label": "Review text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
