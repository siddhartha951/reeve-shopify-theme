{{ 'section-hydration-gap.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hg_style = '--hg-bg: ' | append: section.settings.bg_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-text: ' | append: section.settings.text_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-muted: ' | append: section.settings.muted_text_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-accent: ' | append: section.settings.accent_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-before-bg: ' | append: section.settings.before_bg_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-after-bg: ' | append: section.settings.after_bg_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-before-icon: ' | append: section.settings.before_icon_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-after-icon: ' | append: section.settings.after_icon_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-border: ' | append: section.settings.border_color | append: ';'
  assign hg_style = hg_style | append: ' --hg-badge-bg: ' | append: section.settings.badge_strip_bg | append: ';'
  assign hg_style = hg_style | append: ' --hg-badge-text: ' | append: section.settings.badge_strip_text | append: ';'
  assign hg_style = hg_style | append: ' --hg-padding-top: ' | append: section.settings.padding_top | append: 'px;'
  assign hg_style = hg_style | append: ' --hg-padding-bottom: ' | append: section.settings.padding_bottom | append: 'px;'
-%}
{%- if section.settings.background_image != blank -%}
  {%- assign hg_bg_image_url = section.settings.background_image | image_url: width: 2000 -%}
  {%- assign hg_style = hg_style | append: " --hg-bg-image: url('" | append: hg_bg_image_url | append: "');" -%}
{%- endif -%}

<section class="hg-section" id="shopify-section-{{ section.id }}" style="{{ hg_style }}">
  <div class="hg-inner">

    <div class="hg-header">
      <div class="hg-header__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hg-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="hg-heading">{{ section.settings.heading }}</h2>

        {%- if section.settings.paragraph != blank -%}
          <div class="hg-paragraph">{{ section.settings.paragraph }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      assign timeline_count = 0
      for block in section.blocks
        if block.type == 'timeline_item'
          assign timeline_count = timeline_count | plus: 1
        endif
      endfor
    -%}

    {%- if timeline_count > 0 -%}
      <div class="hg-timeline" style="--hg-timeline-count: {{ timeline_count }};">
        {%- for block in section.blocks -%}
          {%- if block.type == 'timeline_item' -%}
            <div class="hg-timeline__item" {{ block.shopify_attributes }}>
              <span class="hg-timeline__connector"></span>
              <div class="hg-timeline__icon {% if block.settings.highlight %}hg-timeline__icon--accent{% endif %}" style="{% if block.settings.highlight %}border-color: {{ block.settings.icon_color }};{% endif %}">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {{ block.settings.emoji_icon }}
                {%- endif -%}
              </div>
              <div class="hg-timeline__label">
                <p class="hg-timeline__time" style="color: {{ block.settings.icon_color }};">{{ block.settings.time_label }}</p>
                <p class="hg-timeline__title">{{ block.settings.title }}</p>
              </div>
              <p class="hg-timeline__desc">{{ block.settings.description }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign before_count = 0
      assign after_count = 0
      assign mineral_count = 0
      for block in section.blocks
        if block.type == 'before_item'
          assign before_count = before_count | plus: 1
        endif
        if block.type == 'after_item'
          assign after_count = after_count | plus: 1
        endif
        if block.type == 'mineral'
          assign mineral_count = mineral_count | plus: 1
        endif
      endfor
    -%}

    <div class="hg-compare">
      <div class="hg-compare__panel hg-compare__panel--before">
        <p class="hg-compare__label">{{ section.settings.before_label }}</p>
        <div class="hg-compare__divider"></div>
        <ul class="hg-compare__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'before_item' -%}
              <li class="hg-compare__list-item" {{ block.shopify_attributes }}>
                <span class="hg-compare__icon">✕</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="hg-compare__panel hg-compare__panel--after">
        <p class="hg-compare__label">{{ section.settings.after_label }}</p>
        <div class="hg-compare__divider"></div>
        <ul class="hg-compare__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'after_item' -%}
              <li class="hg-compare__list-item" {{ block.shopify_attributes }}>
                <span class="hg-compare__icon">✓</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    {%- if mineral_count > 0 -%}
      <div class="hg-minerals {% if section.settings.show_minerals_desktop %}hg-minerals--visible{% endif %}" data-mobile-visible="true">
        <p class="hg-minerals__label">{{ section.settings.minerals_label }}</p>
        <div class="hg-minerals__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'mineral' -%}
              <div class="hg-mineral" {{ block.shopify_attributes }}>
                <div class="hg-mineral__symbol">{{ block.settings.symbol }}</div>
                <p class="hg-mineral__name">{{ block.settings.name }}</p>
                <p class="hg-mineral__desc">{{ block.settings.description }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- liquid
      assign badge_count = 0
      for block in section.blocks
        if block.type == 'badge'
          assign badge_count = badge_count | plus: 1
        endif
      endfor
    -%}

    {%- if badge_count > 0 -%}
      <div class="hg-badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <span
              class="hg-badges__item{% if block.settings.background_color != blank %} hg-badges__item--filled{% endif %}"
              {{ block.shopify_attributes }}
              {%- if block.settings.background_color != blank %}
              style="background-color: {{ block.settings.background_color }};"
              {%- endif %}
            >
              {%- if block.settings.show_icon -%}🌿{%- endif -%}
              {{ block.settings.text }}
            </span>
            {%- unless forloop.last -%}<span class="hg-badges__divider"></span>{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    const script = document.currentScript;
    const scope = (script && script.closest('.shopify-section')) || document;
    const track = scope.querySelector('.hg-timeline');
    if (!track) return;

    Promise.all([import('@theme/motion'), import('@theme/scroll-container')]).then(([{ gsap, ScrollTrigger, prefersReducedMotion }, { getScrollContainer }]) => {
      const items = track.querySelectorAll('.hg-timeline__item');
      const connectors = track.querySelectorAll('.hg-timeline__connector');
      const icons = track.querySelectorAll('.hg-timeline__icon');
      if (!items.length) return;

      if (prefersReducedMotion()) {
        gsap.set(items, { opacity: 1, y: 0 });
        gsap.set(connectors, { scaleX: 1 });
        gsap.set(icons, { scale: 1 });
        return;
      }

      gsap.set(items, { opacity: 0, y: 16 });
      gsap.set(icons, { scale: 0.4 });
      gsap.set(connectors, { scaleX: 0, transformOrigin: 'left center' });

      ScrollTrigger.create({
        scroller: getScrollContainer(),
        trigger: track,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          const tl = gsap.timeline();
          items.forEach((item, index) => {
            const connector = item.querySelector('.hg-timeline__connector');
            const icon = item.querySelector('.hg-timeline__icon');
            if (connector && index > 0) {
              tl.to(connector, { scaleX: 1, duration: 0.25, ease: 'power1.inOut' }, '>-0.05');
            }
            tl.to(item, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' }, '<');
            if (icon) {
              tl.to(icon, { scale: 1, duration: 0.4, ease: 'back.out(2)' }, '<');
            }
          });
        },
      });
    });
  })();
</script>

