<script>
  (function () {
    const script = document.currentScript;
    const scope = (script && script.closest('.shopify-section')) || document;
    const root = scope.querySelector('[data-blint-product]');
    if (!root) return;

    import('@theme/motion').then(({ gsap, ScrollTrigger, prefersReducedMotion }) => {
      const bg = root.querySelector('[data-blint-bg-image]');
      const cards = root.querySelectorAll('.blint-product__gallery, .blint-product__info');
      if (!cards.length) return;

      if (prefersReducedMotion()) {
        gsap.set(cards, { opacity: 1, y: 0 });
        return;
      }

      gsap.set(cards, { opacity: 0, y: 40 });
      ScrollTrigger.batch(cards, {
        start: 'top 88%',
        once: true,
        onEnter: (batch) => {
          gsap.to(batch, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.15 });
        },
      });

      if (bg) {
        const image = bg.querySelector('.blint-product__bg-image');
        if (image) {
          gsap.fromTo(
            image,
            { yPercent: -6, scale: 1.1 },
            {
              yPercent: 6,
              scale: 1.1,
              ease: 'none',
              scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true },
            }
          );
        }
      }
    });
  })();
</script>

