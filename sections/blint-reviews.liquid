{%- assign reviews = section.blocks | where: 'type', 'review' -%}

<div
  class="blint-reviews spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %} --heading-size: {{ section.settings.heading_font_size }}px;"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  <div class="blint-reviews__inner">
    <div class="blint-reviews__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="blint-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.rating_value != blank -%}
        <div class="blint-reviews__summary">
          <span class="blint-reviews__summary-value">{{ section.settings.rating_value }}</span>
          <span class="blint-reviews__stars" aria-hidden="true">
            {%- for i in (1..5) -%}<span class="blint-reviews__star">&#9733;</span>{%- endfor -%}
          </span>
          {%- if section.settings.rating_count != blank -%}
            <span class="blint-reviews__summary-count">{{ section.settings.rating_count }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if reviews.size > 0 -%}
      <div class="blint-reviews__track">
        {%- for block in reviews -%}
          <article class="blint-reviews__card" {{ block.shopify_attributes }}>
            <div class="blint-reviews__card-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="blint-reviews__star{% if i > block.settings.stars %} is-empty{% endif %}">&#9733;</span>
              {%- endfor -%}
            </div>

            {%- if block.settings.text != blank -%}
              <p class="blint-reviews__card-text">{{ block.settings.text }}</p>
            {%- endif -%}

            <div class="blint-reviews__card-footer">
              {%- if block.settings.name != blank -%}
                <span class="blint-reviews__card-name">{{ block.settings.name }}</span>
              {%- endif -%}

              <div class="blint-reviews__pills">
                {%- if block.settings.product_label != blank -%}
                  <span class="blint-reviews__pill blint-reviews__pill--product">{{ block.settings.product_label }}</span>
                {%- endif -%}
                {%- if block.settings.flavor != blank -%}
                  <span
                    class="blint-reviews__pill blint-reviews__pill--flavor"
                    style="--flavor: {{ block.settings.flavor_color }};"
                  >
                    <svg class="blint-reviews__check" viewBox="0 0 16 16" aria-hidden="true">
                      <circle cx="8" cy="8" r="8" fill="currentColor"/>
                      <path d="M4.5 8.2 6.9 10.6 11.5 5.6" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ block.settings.flavor }}
                  </span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .blint-reviews {
    background: var(--blint-ink, #3529E6);
  }

  .blint-reviews__heading {
    color: #fff;
  }

  .blint-reviews__summary-value,
  .blint-reviews__summary-count {
    color: #fff;
  }

  .blint-reviews__inner {
    max-width: var(--page-width, 1500px);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }

  .blint-reviews__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .blint-reviews__heading {
    margin: 0;
    font-family: var(--blint-heading-font, 'Titillium Web', sans-serif);
    font-weight: var(--blint-heading-weight, 700);
    font-size: min(var(--heading-size, 52px), 14vw);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .blint-reviews__heading::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 4px;
    margin-top: 1.1rem;
    border-radius: 2px;
    background: var(--blint-accent, #4f5bd5);
  }

  .blint-reviews__summary {
    flex-shrink: 0;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.25rem 0.5rem;
    text-align: right;
  }

  .blint-reviews__summary-value {
    font-weight: var(--blint-heading-weight, 700);
    font-size: 1.5rem;
  }

  .blint-reviews__summary-count {
    grid-column: 1 / -1;
    text-align: right;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .blint-reviews__stars {
    color: #f5b50a;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  /* Track / carousel */
  .blint-reviews__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scrollbar-width: thin;
  }

  .blint-reviews__card {
    scroll-snap-align: start;
    flex: 0 0 clamp(260px, 80vw, 330px);
    display: flex;
    flex-direction: column;
    min-height: 320px;
    padding: 1.75rem 1.5rem;
    border-radius: 20px;
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.06);
    box-shadow: 0 10px 30px -18px rgb(79 91 213 / 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .blint-reviews__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgb(79 91 213 / 0.5);
  }

  .blint-reviews__card-stars {
    color: #f5b50a;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .blint-reviews__star.is-empty {
    color: #d9d9d9;
  }

  .blint-reviews__card-text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--color-foreground, #111);
  }

  .blint-reviews__card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .blint-reviews__card-name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .blint-reviews__pills {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .blint-reviews__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .blint-reviews__pill--product {
    background: var(--blint-accent, #111);
    color: var(--blint-accent-text, #fff);
  }

  .blint-reviews__pill--flavor {
    color: var(--flavor, #2e7d32);
    background: color-mix(in srgb, var(--flavor, #2e7d32) 14%, #fff);
  }

  .blint-reviews__check {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--flavor, #2e7d32);
  }

  @media screen and (max-width: 749px) {
    .blint-reviews__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .blint-reviews__summary {
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blint reviews",
  "tag": "section",
  "class": "blint-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people are saying"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 52
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Rating count",
      "default": "500+ Reviews"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Focus"
        },
        {
          "type": "text",
          "id": "flavor",
          "label": "Flavor"
        },
        {
          "type": "color",
          "id": "flavor_color",
          "label": "Flavor color",
          "default": "#2e7d32"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blint reviews",
      "blocks": [
        { "type": "review", "settings": { "text": "Went in skeptical and came away impressed. The lift kicks in within about ten minutes, it's clean, and there's no jittery comedown.", "name": "Marcus R.", "product_label": "Prime", "flavor": "Wintergreen", "flavor_color": "#2e7d32" } },
        { "type": "review", "settings": { "text": "This is my new desk essential. One before deep work and the focus just clicks in — no afternoon coffee crash to deal with later.", "name": "Sofia L.", "product_label": "Prime", "flavor": "Cool Mint", "flavor_color": "#3aa0e0" } },
        { "type": "review", "settings": { "text": "What sold me is that I can reach for one in the afternoon and still sleep fine that night. The flavors are genuinely good too.", "name": "Devin O.", "product_label": "Flow", "flavor": "Variety Pack", "flavor_color": "#9c1b3a" } },
        { "type": "review", "settings": { "text": "I keep a tin in my bag, one in the car, and one in my gym kit. They've quietly become part of my daily routine — the tropical is my favorite.", "name": "Priya N.", "product_label": "Prime", "flavor": "Tropical", "flavor_color": "#e0a106" } }
      ]
    }
  ]
}
{% endschema %}
