  }

  .reeve-reviews__search svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    opacity: 0.5;
  }

  .reeve-reviews__search input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    background: none;
    font-family: inherit;
    font-size: 0.85rem;
    color: inherit;
  }

  .reeve-reviews__search input:focus {
    outline: none;
  }

  /* ---------- Modal review list ---------- */
  .reeve-reviews__modal-list {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    overflow-y: auto;
    padding-right: 0.25rem;
    transition: opacity 0.2s ease;
  }

  .reeve-reviews__modal-list[aria-busy='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  .reeve-reviews__modal-item {
    border: 1px solid var(--rr-card-border, #e2d7c3);
    border-radius: 14px;
    padding: 1.1rem 1.25rem;
    background: var(--rr-card-bg, #fff);
  }

  .reeve-reviews__modal-item-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .reeve-reviews__modal-item-stars {
    display: flex;
    gap: 0.1rem;
    color: var(--rr-accent, #d6316f);
  }

  .reeve-reviews__modal-item-stars svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .reeve-reviews__modal-item-stars .is-empty {
    opacity: 0.25;
  }

  .reeve-reviews__modal-item-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .reeve-reviews__modal-item-body {
    margin: 0 0 0.65rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--rr-muted, #6b6f68);
  }

  .reeve-reviews__modal-item-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
  }

  .reeve-reviews__modal-item-name {
    font-weight: 700;
  }

  .reeve-reviews__modal-item-date {
    color: var(--rr-muted, #6b6f68);
  }

  .reeve-reviews__modal-empty {
    text-align: center;
    padding: 2rem 0;
    opacity: 0.6;
  }

  .reeve-reviews__modal-empty[hidden] {
    display: none;
  }

  /* ---------- Modal pagination ---------- */
  .reeve-reviews__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
  }

  .reeve-reviews__page-btn {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rr-card-border, #e2d7c3);
    border-radius: 8px;
    background: var(--rr-card-bg, #fff);
    color: var(--rr-text, #10192b);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .reeve-reviews__page-btn.is-active {
    background: var(--rr-text, #10192b);
    border-color: var(--rr-text, #10192b);
    color: #fff;
  }

  .reeve-reviews__page-nav {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    color: var(--rr-text, #10192b);
    cursor: pointer;
  }

  .reeve-reviews__page-nav svg {
    width: 1rem;
    height: 1rem;
  }

  .reeve-reviews__page-nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .reeve-reviews * {
      transition: none !important;
    }
  }
{% endstylesheet %}

