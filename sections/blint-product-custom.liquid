{%- liquid
  assign product = section.settings.selected_product
  assign current_variant = product.selected_or_first_available_variant
  assign sp_group = product.selling_plan_groups | first
  assign sp = nil
  if sp_group
    assign sp = sp_group.selling_plans | first
    if section.settings.default_frequency_name != blank
      for plan in sp_group.selling_plans
        if plan.name == section.settings.default_frequency_name
          assign sp = plan
          break
        endif
      endfor
    endif
  endif
  assign default_subscribe = false
  if sp and section.settings.default_to_subscription
    assign default_subscribe = true
  endif
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign batch_prev_ts = section.settings.batch_prev_offset | times: 86400 | plus: now_ts
  assign batch_current_ts = section.settings.batch_current_offset | times: 86400 | plus: now_ts
  assign batch_next_ts = section.settings.batch_next_offset | times: 86400 | plus: now_ts
-%}

<section
  class="blint-product spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %} --blint-cta: {{ section.settings.cta_color }}; --blint-cta-text: {{ section.settings.cta_text_color }}; --blint-product-title-size: {{ section.settings.title_font_size }}px; --blint-product-desc-size: {{ section.settings.description_font_size }}px;{% if section.settings.urgency_background != blank %} --blint-urgency-bg: {{ section.settings.urgency_background }};{% endif %}"
  data-blint-product
  data-money-format="{{ shop.money_format | escape }}"
  {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
>
  <div class="blint-product__inner">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="blint-product__gallery">
      <div class="blint-product__main">
        {%- if current_variant.featured_media != blank -%}
          {%- assign main_media = current_variant.featured_media -%}
        {%- else -%}
          {%- assign main_media = product.featured_media -%}
        {%- endif -%}
        {%- if main_media != blank -%}
          {{
            main_media
            | image_url: width: 1200
            | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 750, 1000, 1200', class: 'blint-product__main-image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'blint-product__main-image' }}
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="blint-product__thumbs" role="list">
          {%- for media in product.media -%}
            <button
              type="button"
              class="blint-product__thumb{% if forloop.first %} is-active{% endif %}"
              data-thumb
              data-media-id="{{ media.id }}"
              data-full="{{ media | image_url: width: 1200 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', alt: media.alt | default: product.title | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="blint-product__info">
      {%- if section.settings.title_override != blank -%}
        <h1 class="blint-product__title">{{ section.settings.title_override }}</h1>
      {%- else -%}
        <h1 class="blint-product__title">{{ product.title }}</h1>
      {%- endif -%}

      {%- if section.settings.short_description != blank -%}
        <div class="blint-product__short-desc">{{ section.settings.short_description }}</div>
      {%- endif -%}

      {%- if section.settings.show_rating and section.settings.rating_value != blank -%}
        <div class="blint-product__rating">
          <span class="blint-product__rating-stars" aria-hidden="true">
            {%- for i in (1..5) -%}<span>&#9733;</span>{%- endfor -%}
          </span>
          <span class="blint-product__rating-value">{{ section.settings.rating_value }}</span>
          {%- if section.settings.rating_count != blank -%}
            <span class="blint-product__rating-count">{{ section.settings.rating_count }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="blint-product__desc">{{ section.settings.description }}</div>
      {%- elsif product.description != blank -%}
        <div class="blint-product__desc">{{ product.description }}</div>
      {%- endif -%}

      {%- assign bullets = section.settings.bullets | newline_to_br | split: '<br />' -%}
      {%- if section.settings.bullets != blank -%}
        <ul class="blint-product__benefits" role="list">
          {%- for bullet in bullets -%}
            {%- assign clean = bullet | strip -%}
            {%- if clean != blank -%}
              <li class="blint-product__benefit"><span class="blint-product__benefit-mark" aria-hidden="true">&#10037;</span><span>{{ clean }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign chips = section.settings.chips | split: ',' -%}
      {%- if section.settings.chips != blank -%}
        <ul class="blint-product__chips" role="list">
          {%- for chip in chips -%}
            {%- assign chip_clean = chip | strip -%}
            {%- if chip_clean != blank -%}<li class="blint-product__chip">{{ chip_clean }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} ---------- Form ---------- {%- endcomment -%}
      {%- form 'product', product, id: 'blint-product-form', class: 'blint-product__form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="selling_plan" value="{% if default_subscribe %}{{ sp.id }}{% endif %}" data-selling-plan {% unless default_subscribe %}disabled{% endunless %}>
        {%- comment -%} return_to=/checkout adds the item, then redirects straight to checkout (fallback for native submit) {%- endcomment -%}
        <input type="hidden" name="return_to" value="/checkout">

        {%- for option in product.options_with_values -%}
          {%- assign name_down = option.name | downcase -%}
          {%- assign is_count = false -%}
          {%- if name_down contains 'count' or name_down contains 'can' or name_down contains 'pack' or name_down contains 'size' or name_down contains 'quantity' or name_down contains 'qty' -%}
            {%- assign is_count = true -%}
          {%- endif -%}
          <fieldset class="blint-product__option" data-option-index="{{ forloop.index }}" {% if is_count %}data-count-option data-badges-enabled="{{ section.settings.show_quantity_badges }}"{% endif %}>
            <legend class="blint-product__option-name">{{ option.name }}</legend>
            <div class="blint-product__pills{% if is_count %} blint-product__pills--count{% endif %}">
              {%- for value in option.values -%}
                {%- liquid
                  assign opt_idx0 = forloop.parentloop.index0
                  assign value_image = nil
                  unless is_count
                    for v in product.variants
                      if v.options[opt_idx0] == value and v.featured_media != blank
                        assign value_image = v.featured_media
                        break
                      endif
                    endfor
                  endunless
                -%}
                <label class="blint-product__pill{% if is_count %} blint-product__pill--count{% endif %}{% if value_image %} blint-product__pill--image{% endif %}">
                  <input
                    type="radio"
                    name="blint-option-{{ forloop.parentloop.index }}"
                    value="{{ value | escape }}"
                    data-option-input
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  {%- if value_image -%}
                    <span class="blint-product__pill-thumb">{{ value_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', alt: '' }}</span>
                  {%- endif -%}
                  <span class="blint-product__pill-label">{{ value }}</span>
                  {%- if is_count -%}<span class="blint-product__pill-badge" data-badge-for="{{ value | escape }}" hidden></span>{%- endif -%}
                </label>
              {%- endfor -%}
            </div>
            {%- if is_count -%}
              <p
                class="blint-product__upgrade-hint"
                data-upgrade-hint
                data-template="{{ section.settings.upgrade_text | escape }}"
                data-best-text="{{ section.settings.best_value_text | escape }}"
                hidden
              ></p>
            {%- endif -%}
          </fieldset>
        {%- endfor -%}

        {%- if sp -%}
          <div class="blint-product__purchase" data-purchase-group>
            <div class="blint-product__purchase-option blint-product__purchase-option--subscribe">
              <label class="blint-product__purchase-head">
                <input type="radio" name="blint-purchase" value="subscribe" data-purchase-input data-plan="{{ sp.id }}" {% if default_subscribe %}checked{% endif %}>
                <span class="blint-product__purchase-row">
                  <span class="blint-product__purchase-main">
                    <span class="blint-product__purchase-radio" aria-hidden="true"></span>
                    <span>{{ section.settings.subscribe_label }}</span>
                  </span>
                  <span class="blint-product__purchase-save" data-sub-save></span>
                </span>
              </label>

              <div class="blint-product__frequency" data-frequency-wrap{% unless default_subscribe %} hidden{% endunless %}>
                <label class="blint-product__frequency-label" for="blint-frequency-{{ section.id }}">{{ section.settings.frequency_label }}</label>
                <div class="blint-product__frequency-control">
                  <select id="blint-frequency-{{ section.id }}" class="blint-product__frequency-select" data-frequency aria-label="{{ section.settings.frequency_label | escape }}">
                    {%- for plan in sp_group.selling_plans -%}
                      <option value="{{ plan.id }}"{% if plan.id == sp.id %} selected{% endif %}>{{ plan.name }}</option>
                    {%- endfor -%}
                  </select>
                  <span class="blint-product__frequency-caret" aria-hidden="true">&#9662;</span>
                </div>
              </div>

              {%- if section.settings.sub_note_right != blank -%}
                <span class="blint-product__sub-note-single">{{ section.settings.sub_note_right }}</span>
              {%- endif -%}
            </div>
            <label class="blint-product__purchase-option">
              <input type="radio" name="blint-purchase" value="onetime" data-purchase-input {% unless default_subscribe %}checked{% endunless %}>
              <span class="blint-product__purchase-main">
                <span class="blint-product__purchase-radio" aria-hidden="true"></span>
                <span>{{ section.settings.onetime_label }}</span>
              </span>
            </label>
          </div>
        {%- endif -%}

        <div class="blint-product__pricebox">
          <div class="blint-product__pricebox-main">
            {%- if section.settings.offer_label != blank -%}
              <div class="blint-product__offer">
                <span class="blint-product__offer-label">{{ section.settings.offer_label }}</span>
                <span class="blint-product__offer-badge" data-offer-badge hidden></span>
              </div>
            {%- endif -%}
            <div class="blint-product__price-row">
              <span class="blint-product__price-compare" data-price-compare hidden></span>
              <span class="blint-product__price" data-price></span>
            </div>
          </div>
          <span class="blint-product__savings" data-savings-wrap hidden>
            <span class="blint-product__savings-label">{{ section.settings.savings_label }}</span>
            <span class="blint-product__savings-value" data-savings></span>
          </span>
        </div>

        <div class="blint-product__buy-row">
          <div class="blint-product__qty">
            <button type="button" class="blint-product__qty-btn" data-qty-minus aria-label="Decrease quantity">&#8722;</button>
            <input type="text" name="quantity" value="1" class="blint-product__qty-input" data-qty-input inputmode="numeric" aria-label="Quantity">
            <button type="button" class="blint-product__qty-btn" data-qty-plus aria-label="Increase quantity">&#43;</button>
          </div>
          <button type="submit" class="blint-product__atc" data-atc>
            <span data-atc-label>{{ section.settings.atc_label }}</span>
            <span class="blint-product__atc-arrow" aria-hidden="true">&#8594;</span>
            <span data-atc-price></span>
          </button>
        </div>

        {%- assign guarantees = section.settings.guarantees | split: ',' -%}
        {%- if section.settings.guarantees != blank -%}
          <ul class="blint-product__guarantees" role="list">
            {%- for g in guarantees -%}
              {%- assign g_clean = g | strip -%}
              {%- if g_clean != blank -%}
                <li class="blint-product__guarantee">
                  <svg class="blint-product__guarantee-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{{ g_clean }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.countdown_enable or section.settings.urgency_value != blank -%}
        <div class="blint-product__urgency">
          <p class="blint-product__urgency-head">{{ section.settings.urgency_heading }}</p>
          {%- if section.settings.countdown_enable -%}
            <div class="blint-product__countdown" data-countdown data-cutoff-hour="{{ section.settings.countdown_cutoff_hour }}" role="timer" aria-label="Time left to order">
              <span class="blint-product__cd-unit"><b data-cd-h>00</b><small>hrs</small></span>
              <span class="blint-product__cd-sep" aria-hidden="true">:</span>
              <span class="blint-product__cd-unit"><b data-cd-m>00</b><small>min</small></span>
              <span class="blint-product__cd-sep" aria-hidden="true">:</span>
              <span class="blint-product__cd-unit"><b data-cd-s>00</b><small>sec</small></span>
            </div>
          {%- elsif section.settings.urgency_value != blank -%}
            <p class="blint-product__urgency-value"><strong>{{ section.settings.urgency_value }}</strong></p>
          {%- endif -%}
          {%- if section.settings.urgency_text != blank -%}
            {%- assign urgency_lines = section.settings.urgency_text | newline_to_br | split: '<br />' -%}
            <div class="blint-product__urgency-text">
              {%- for line in urgency_lines -%}
                {%- assign line_clean = line | strip -%}
                {%- if line_clean != blank -%}<p>{{ line_clean }}</p>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="blint-product__sticky" data-sticky aria-hidden="true">
    <div class="blint-product__sticky-inner">
      <button type="button" class="blint-product__atc blint-product__sticky-btn" data-sticky-atc>
        <span data-sticky-label>{{ section.settings.atc_label }}</span>
        <span class="blint-product__atc-arrow" aria-hidden="true">&#8594;</span>
        <span data-sticky-price></span>
      </button>
    </div>
  </div>

  <script type="application/json" data-blint-variants>
    {
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "available": {{ v.available }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
            "media_id": {{ v.featured_media.id | default: 0 | json }},
            "plans": [
              {%- for a in v.selling_plan_allocations -%}
                { "id": {{ a.selling_plan.id }}, "price": {{ a.price }}, "compare_at_price": {{ a.compare_at_price | default: 0 | json }} }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% stylesheet %}
  .blint-product__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    max-width: var(--page-width, 1500px);
    margin-inline: auto;
    padding-inline: clamp(0.5rem, 4vw, 4rem);
  }

  .blint-product__gallery,
  .blint-product__gallery,
  .blint-product__gallery,
  .blint-product__info {
    min-width: 0;
  }

  /* Buy box as a branded card */
  .blint-product__info {
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
    border-radius: 24px;
    background: #fff;
    padding: clamp(0.5rem, 4vw, 2.25rem);
    box-shadow: 0 24px 50px -32px rgb(53 41 230 / 0.4);
  }

  @media screen and (min-width: 990px) {
    .blint-product__gallery {
      position: sticky;
      top: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .blint-product__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
      align-items: start;
    }
  }

  /* Gallery */
  .blint-product__main {
    border-radius: 24px;
    overflow: hidden;
    background: #f1f1f3;
  }

  .blint-product__main-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .blint-product__thumbs {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .blint-product__thumbs::-webkit-scrollbar { display: none; }

  .blint-product__thumb {
    flex: 0 0 78px;
    width: 78px;
    height: 78px;
    padding: 0;
    border: none;
    border-radius: 14px;
    overflow: hidden;
    background: #f1f1f3;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .blint-product__thumb:hover {
    opacity: 0.75;
  }

  .blint-product__thumb.is-active {
    opacity: 1;
  }

  .blint-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Info */
  .blint-product__title {
    margin: 0;
    font-family: var(--blint-heading-font, 'Titillium Web', sans-serif);
    font-weight: var(--blint-heading-weight, 700);
    font-size: min(var(--blint-product-title-size, 56px), 11vw);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: none;
    overflow-wrap: break-word;
  }

  .blint-product__short-desc {
    display: inline-flex;
    align-items: center;
    margin-top: 0.85rem;
    padding: 0.6rem 1.1rem;
    border-radius: 10px;
    background: #111;
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.3;
  }

  .blint-product__short-desc p { margin: 0; }

  .blint-product__desc {
    margin-top: 1.25rem;
    font-size: var(--blint-product-desc-size, 17px);
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.85);
  }

  .blint-product__desc > :first-child { margin-top: 0; }
  .blint-product__desc > :last-child { margin-bottom: 0; }

  .blint-product__desc p { margin: 0 0 0.6rem; }

  .blint-product__desc :is(h1, h2, h3, h4, h5, h6),
  .blint-product__desc p strong:only-child {
    margin: 1rem 0 0.4rem;
  }

  .blint-product__desc ul,
  .blint-product__desc ol {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
  }

  .blint-product__desc li { margin-bottom: 0.25rem; }

  .blint-product__benefits {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .blint-product__benefit {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
  }

  .blint-product__benefit-mark { color: var(--color-foreground, #111); }

  /* Rating row */
  .blint-product__rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .blint-product__rating-stars { color: #f5b50a; font-size: 1rem; letter-spacing: 0.05em; }
  .blint-product__rating-value { font-weight: 700; font-size: 0.95rem; }
  .blint-product__rating-count {
    font-size: 0.8rem;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
  }

  /* Ingredient chips */
  .blint-product__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .blint-product__chip {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blint-ink, #3529E6) 8%, #fff);
    border: 1px solid color-mix(in srgb, var(--blint-ink, #3529E6) 18%, transparent);
    color: var(--blint-ink, #3529E6);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  /* Guarantee row */
  .blint-product__guarantees {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .blint-product__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.7);
  }
  .blint-product__guarantee-check {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    color: var(--blint-ink, #3529E6);
  }

  .blint-product__form { margin-top: 2rem; }

  .blint-product__option {
    border: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .blint-product__option-name {
    padding: 0;
    margin-bottom: 0.75rem;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.6);
  }

  .blint-product__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .blint-product__pills--count {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .blint-product__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1.5px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.15);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .blint-product__pill input { position: absolute; opacity: 0; pointer-events: none; }

  .blint-product__pill--image {
    padding-left: 0.45rem;
  }

  .blint-product__pill-thumb {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
  }

  .blint-product__pill-thumb img {
    width: 100%;
    height: 100%;
