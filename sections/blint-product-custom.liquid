{% endstylesheet %}

{% raw %}
<script>
  (function () {
    const script = document.currentScript;
    const scope = (script && script.closest('.shopify-section')) || document;
    const root = scope.querySelector('[data-blint-product]') || (script && script.previousElementSibling);
    if (!root) return;
    const dataEl = root.querySelector('[data-blint-variants]');
    if (!dataEl) return;
    const variants = (JSON.parse(dataEl.textContent) || {}).variants || [];
    const moneyFormat = root.getAttribute('data-money-format') || '${{amount}}';

    function formatMoney(cents) {
      cents = parseInt(cents, 10) || 0;
      const value = cents / 100;
      const fixed = value.toFixed(2);
      const withCommas = fixed.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      const noDecimals = withCommas.split('.')[0];
      return moneyFormat
        .replace(/\{\{\s*amount\s*\}\}/g, withCommas)
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, noDecimals)
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, fixed.replace('.', ','));
    }

    const variantInput = root.querySelector('[data-variant-id]');
    const sellingPlanInput = root.querySelector('[data-selling-plan]');
    const optionInputs = Array.from(root.querySelectorAll('[data-option-input]'));
    const purchaseInputs = Array.from(root.querySelectorAll('[data-purchase-input]'));
    const priceEl = root.querySelector('[data-price]');
    const compareEl = root.querySelector('[data-price-compare]');
    const savingsWrap = root.querySelector('[data-savings-wrap]');
    const savingsEl = root.querySelector('[data-savings]');
    const atc = root.querySelector('[data-atc]');
    const atcPrice = root.querySelector('[data-atc-price]');
    const offerBadge = root.querySelector('[data-offer-badge]');
    const subSave = root.querySelector('[data-sub-save]');
    const subnotes = root.querySelector('[data-subnotes]');
    const freqSelect = root.querySelector('[data-frequency]');
    const freqWrap = root.querySelector('[data-frequency-wrap]');
    const countOption = root.querySelector('[data-count-option]');
    const upgradeHint = root.querySelector('[data-upgrade-hint]');
    const form = root.querySelector('#blint-product-form') || root.querySelector('form');
    const sticky = root.querySelector('[data-sticky]');
    const stickyAtc = root.querySelector('[data-sticky-atc]');
    const stickyPrice = root.querySelector('[data-sticky-price]');
    const stickyLabel = root.querySelector('[data-sticky-label]');
    const qtyInput = root.querySelector('[data-qty-input]');
    const qtyMinus = root.querySelector('[data-qty-minus]');
    const qtyPlus = root.querySelector('[data-qty-plus]');

    function selectedOptions() {
      const groups = {};
      optionInputs.forEach(function (input) {
        if (input.checked) groups[input.name] = input.value;
      });
      // preserve option order by name
      const names = [];
      optionInputs.forEach(function (i) { if (names.indexOf(i.name) === -1) names.push(i.name); });
      return names.map(function (n) { return groups[n]; });
    }

    function findVariant(opts) {
      return variants.find(function (v) {
        return v.options.length === opts.length && v.options.every(function (o, i) { return o === opts[i]; });
      });
    }

    function isSubscribe() {
      return purchaseInputs.some(function (i) { return i.checked && i.value === 'subscribe'; });
    }

    function currentPlanId() {
      if (!isSubscribe()) return null;
      if (freqSelect && freqSelect.value) return freqSelect.value;
      const checked = purchaseInputs.find(function (i) { return i.checked; });
      return checked ? checked.getAttribute('data-plan') : null;
    }

    function planFor(variant, planId) {
      if (!variant || !planId) return null;
      return (variant.plans || []).find(function (p) { return String(p.id) === String(planId); }) || null;
    }

    function discountPct(price, compare) {
      if (!compare || compare <= price) return 0;
      return Math.round((1 - price / compare) * 100);
    }

    function update() {
      const opts = selectedOptions();
      const variant = findVariant(opts);
      const planId = currentPlanId();

      // Subscription note + frequency selector visibility
      if (subnotes) subnotes.hidden = !planId;
      if (freqWrap) freqWrap.hidden = !isSubscribe();

      if (!variant) {
        atc.disabled = true;
        atc.querySelector('[data-atc-label]').textContent = 'Unavailable';
        if (atcPrice) atcPrice.textContent = '';
        if (stickyAtc) stickyAtc.disabled = true;
        return;
      }

      variantInput.value = variant.id;

      // selling plan input
      if (sellingPlanInput) {
        if (planId) {
          sellingPlanInput.value = planId;
          sellingPlanInput.disabled = false;
        } else {
          sellingPlanInput.value = '';
          sellingPlanInput.disabled = true;
        }
      }

      const plan = planFor(variant, planId);
      const price = plan ? plan.price : variant.price;
      const compare = variant.compare_at_price;

      // swap main image to variant media
      if (variant.media_id) {
        const thumb = root.querySelector('[data-thumb][data-media-id="' + variant.media_id + '"]');
        if (thumb) thumb.click();
      }

      priceEl.textContent = formatMoney(price);

      if (compare && compare > price) {
        compareEl.textContent = formatMoney(compare);
        compareEl.hidden = false;
        savingsEl.textContent = formatMoney(compare - price);
        if (savingsWrap) savingsWrap.hidden = false;
        if (offerBadge) { offerBadge.textContent = discountPct(price, compare) + '% off'; offerBadge.hidden = false; }
      } else {
        compareEl.hidden = true;
        if (savingsWrap) savingsWrap.hidden = true;
        if (offerBadge) offerBadge.hidden = true;
      }

      // Count badges reflect the current purchase mode
      updateCountBadges(planId);
      updateUpgradeHint(planId);

      // subscribe savings label (selected frequency price vs variant compare-at)
      if (subSave) {
        const subPlanInput = purchaseInputs.find(function (i) { return i.value === 'subscribe'; });
        let subPlanId = freqSelect && freqSelect.value ? freqSelect.value : null;
        if (!subPlanId) subPlanId = subPlanInput ? subPlanInput.getAttribute('data-plan') : null;
        const subPlan = planFor(variant, subPlanId);
        const subBase = variant.compare_at_price || variant.price;
        if (subPlan && subPlan.price < subBase) {
          subSave.textContent = 'Save ' + discountPct(subPlan.price, subBase) + '%';
        } else {
          subSave.textContent = '';
        }
      }

      atc.disabled = !variant.available;
      atc.querySelector('[data-atc-label]').textContent = variant.available
        ? atc.getAttribute('data-default-label') || atc.querySelector('[data-atc-label]').textContent
        : 'Sold out';
      if (atcPrice) atcPrice.textContent = variant.available ? formatMoney(price) : '';

      // Mirror to the mobile sticky button
      if (stickyAtc) stickyAtc.disabled = !variant.available;
      if (stickyLabel) stickyLabel.textContent = variant.available ? (atc.getAttribute('data-default-label') || stickyLabel.textContent) : 'Sold out';
      if (stickyPrice) stickyPrice.textContent = variant.available ? formatMoney(price) : '';
    }

    // Count-option discount badges — reflect the selected purchase mode (vs variant compare-at)
    function updateCountBadges(planId) {
      if (!countOption) return;
      const badgesEnabled = countOption.getAttribute('data-badges-enabled') === 'true';
      const countIndex = parseInt(countOption.getAttribute('data-option-index'), 10) - 1;
      countOption.querySelectorAll('[data-badge-for]').forEach(function (badge) {
        if (!badgesEnabled) { badge.hidden = true; return; }
        const value = badge.getAttribute('data-badge-for');
        const rep = variants.find(function (v) { return v.options[countIndex] === value; });
        if (!rep) { badge.hidden = true; return; }
        const repPlan = planFor(rep, planId);
        const repPrice = repPlan ? repPlan.price : rep.price;
        const repCompare = rep.compare_at_price;
        if (repCompare && repCompare > repPrice) {
          badge.textContent = discountPct(repPrice, repCompare) + '% off';
          badge.hidden = false;
        } else {
          badge.hidden = true;
        }
      });
    }

    // Quantity upgrade hint — "Upgrade to X & Save Y%" for lower tiers, a "best value" message on the highest tier
    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function updateUpgradeHint(planId) {
      if (!upgradeHint || !countOption) return;
      const countIndex = parseInt(countOption.getAttribute('data-option-index'), 10) - 1;
      const values = Array.from(countOption.querySelectorAll('[data-badge-for]')).map(function (b) {
        return b.getAttribute('data-badge-for');
      });
      const checkedInput = countOption.querySelector('[data-option-input]:checked');
      const currentValue = checkedInput ? checkedInput.value : null;
      const idx = values.indexOf(currentValue);

      if (idx === -1) { upgradeHint.hidden = true; return; }

      if (idx < values.length - 1) {
        const nextValue = values[idx + 1];
        const rep = variants.find(function (v) { return v.options[countIndex] === nextValue; });
        const repPlan = rep ? planFor(rep, planId) : null;
        const repPrice = rep ? (repPlan ? repPlan.price : rep.price) : 0;
        const repCompare = rep ? rep.compare_at_price : 0;
        const pct = repCompare && repCompare > repPrice ? discountPct(repPrice, repCompare) : 0;

        if (pct > 0) {
          const template = upgradeHint.getAttribute('data-template') || 'Upgrade to [quantity] & Save [percent]!';
          upgradeHint.innerHTML = template
            .replace(/\[\s*quantity\s*\]/g, '<span class="blint-product__hint-hl">' + escapeHtml(nextValue) + '</span>')
            .replace(/\[\s*percent\s*\]/g, '<span class="blint-product__hint-hl">' + pct + '%</span>');
          upgradeHint.hidden = false;
        } else {
          upgradeHint.hidden = true;
        }
      } else {
        const bestText = upgradeHint.getAttribute('data-best-text');
        if (bestText) {
          upgradeHint.textContent = bestText;
          upgradeHint.hidden = false;
        } else {
          upgradeHint.hidden = true;
        }
      }
    }

    // store default label
    if (atc) atc.setAttribute('data-default-label', atc.querySelector('[data-atc-label]').textContent);

    // Thumbnail gallery
    const mainImage = root.querySelector('.blint-product__main-image');
    root.querySelectorAll('[data-thumb]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        const full = thumb.getAttribute('data-full');
        if (mainImage && full) { mainImage.src = full; mainImage.removeAttribute('srcset'); }
        root.querySelectorAll('[data-thumb]').forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
    });

    optionInputs.concat(purchaseInputs).forEach(function (input) {
      input.addEventListener('change', update);
    });

    if (freqSelect) freqSelect.addEventListener('change', update);

    // Quantity stepper
    function clampQty(n) {
      n = parseInt(n, 10);
      return !n || n < 1 ? 1 : n;
    }
    if (qtyInput) {
      if (qtyMinus) qtyMinus.addEventListener('click', function () { qtyInput.value = Math.max(1, clampQty(qtyInput.value) - 1); });
      if (qtyPlus) qtyPlus.addEventListener('click', function () { qtyInput.value = clampQty(qtyInput.value) + 1; });
      qtyInput.addEventListener('change', function () { qtyInput.value = clampQty(qtyInput.value); });
    }

    // Add to cart, then go straight to checkout
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const submitting = form.querySelector('[data-atc]');
        if (submitting) submitting.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        })
          .then(function () { window.location.href = '/checkout'; })
          .catch(function () { form.submit(); });
      });
    }

    // Mobile sticky add-to-cart: submit the same form
    if (stickyAtc && form) {
      stickyAtc.addEventListener('click', function () {
        if (stickyAtc.disabled) return;
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.submit();
        }
      });
    }

    // Reveal the sticky bar once the main button scrolls out of view
    if (sticky && atc && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          sticky.classList.toggle('is-visible', !entry.isIntersecting);
          sticky.setAttribute('aria-hidden', entry.isIntersecting ? 'true' : 'false');
        });
      }, { rootMargin: '0px 0px -10% 0px' });
      observer.observe(atc);
    }

    // Live countdown timer (hardcoded: counts to the daily cutoff hour; wire to a real cutoff later)
    var cd = root.querySelector('[data-countdown]');
    if (cd) {
      var cutoffHour = parseInt(cd.getAttribute('data-cutoff-hour'), 10) || 0;
      var hEl = cd.querySelector('[data-cd-h]');
      var mEl = cd.querySelector('[data-cd-m]');
      var sEl = cd.querySelector('[data-cd-s]');
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      var tick = function () {
        var now = new Date();
        var target = new Date(now);
        target.setHours(cutoffHour, 0, 0, 0);
        if (target <= now) target.setDate(target.getDate() + 1);
        var diff = Math.max(0, Math.floor((target - now) / 1000));
        var h = Math.floor(diff / 3600); diff -= h * 3600;
        var m = Math.floor(diff / 60); var s = diff - m * 60;
        if (hEl) hEl.textContent = pad(h);
        if (mEl) mEl.textContent = pad(m);
        if (sEl) sEl.textContent = pad(s);
      };
      tick();
      setInterval(tick, 1000);
    }

    update();
  })();
</script>
{% endraw %}

