{%- liquid
  assign features = section.blocks | where: 'type', 'feature'
  assign ingredients = section.blocks | where: 'type', 'ingredient'
-%}

<div
  class="blint-ing spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %} --heading-size: {{ section.settings.heading_font_size }}px;"
  data-blint-ing
  {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
>
  <div class="blint-ing__inner">
    <div class="blint-ing__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="blint-ing__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="blint-ing__body-text">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if features.size > 0 -%}
        <ul class="blint-ing__features" role="list">
          {%- for block in features -%}
            <li class="blint-ing__feature" {{ block.shopify_attributes }}>
              <span class="blint-ing__feature-icon" aria-hidden="true">{%- render 'blint-icon', icon: block.settings.icon -%}</span>
              <span class="blint-ing__feature-label">{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>

    {%- if ingredients.size > 0 -%}
      <div class="blint-ing__track" data-ing-track>
        {%- for block in ingredients -%}
          {%- assign ing_alt = block.settings.name | escape -%}
          <article class="blint-ing__card" {{ block.shopify_attributes }}>
            <div class="blint-ing__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 70vw', widths: '300, 450, 600, 700', alt: ing_alt, class: 'blint-ing__image'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'blint-ing__image' }}
              {%- endif -%}
            </div>

            <div class="blint-ing__card-body">
              {%- if block.settings.name != blank -%}
                <h3 class="blint-ing__name">{{ block.settings.name }}</h3>
              {%- endif -%}

              {%- if block.settings.tags != blank -%}
                <ul class="blint-ing__tags" role="list">
                  {%- assign tag_list = block.settings.tags | split: ',' -%}
                  {%- for tag in tag_list -%}
                    <li class="blint-ing__tag">{{ tag | strip }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="blint-ing__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .blint-ing__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: var(--page-width, 1500px);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }

  @media screen and (min-width: 1000px) {
    .blint-ing__inner {
      grid-template-columns: minmax(260px, 0.85fr) minmax(0, 2.15fr);
      gap: 3rem;
      align-items: start;
    }
  }

  .blint-ing__intro {
    min-width: 0;
  }

  .blint-ing__heading {
    margin: 0;
    font-family: var(--blint-heading-font, 'Titillium Web', sans-serif);
    font-weight: var(--blint-heading-weight, 700);
    font-size: min(var(--heading-size, 56px), 14vw);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .blint-ing__body-text {
    margin-top: 1.5rem;
    max-width: 30rem;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.5;
  }

  .blint-ing__body-text > :first-child { margin-top: 0; }
  .blint-ing__body-text > :last-child { margin-bottom: 0; }

  .blint-ing__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .blint-ing__feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .blint-ing__feature-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-foreground, #111);
  }

  .blint-ing__feature-icon svg { width: 100%; height: 100%; }

  .blint-ing__feature-label {
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Carousel */
  .blint-ing__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
    min-width: 0;
  }

  .blint-ing__track::-webkit-scrollbar { display: none; }

  .blint-ing__card {
    scroll-snap-align: start;
    flex: 0 0 clamp(260px, 78vw, 340px);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .blint-ing__media {
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
  }

  .blint-ing__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blint-ing__card-body {
    position: relative;
    margin-top: -1.5rem;
    padding: 1.75rem;
    border-radius: 20px;
    background: #f2f2f2;
    flex: 1;
  }

  .blint-ing__name {
    margin: 0;
    font-family: var(--blint-heading-font, 'Titillium Web', sans-serif);
    font-weight: var(--blint-heading-weight, 700);
    font-size: clamp(1.5rem, 2vw, 2rem);
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .blint-ing__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .blint-ing__tag {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .blint-ing__desc {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.8);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blint ingredients",
  "tag": "section",
  "class": "blint-ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science in a pouch"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Feel calm settle in within 5-10 minutes, plus deeper sleep support from a clinically-grounded blend of research-grade nootropics and adaptogens.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sprout", "label": "Sprout" },
            { "value": "lightning", "label": "Lightning" },
            { "value": "flask", "label": "Flask" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "drop", "label": "Drop" }
          ],
          "default": "sprout"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Feature"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Ingredient"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags",
          "info": "Comma-separated, e.g. Calm, Anxiolytic, Sleep onset"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blint ingredients",
      "blocks": [
        { "type": "feature", "settings": { "icon": "sprout", "label": "Plant-powered nootropics" } },
        { "type": "feature", "settings": { "icon": "lightning", "label": "Patented actives" } },
        { "type": "feature", "settings": { "icon": "flask", "label": "Nicotine-free" } },
        { "type": "feature", "settings": { "icon": "sparkle", "label": "Vitamin-enriched" } },
        { "type": "ingredient", "settings": { "name": "Passionflower", "tags": "Calm, Anxiolytic, Sleep onset", "description": "Rich in chrysin and vitexin flavonoids that quiet racing thoughts and reduce sleep latency, helping the body transition smoothly into restorative rest." } },
        { "type": "ingredient", "settings": { "name": "Melatonin", "tags": "Circadian rhythm, Antioxidant", "description": "An endogenous hormone that signals nightfall to the brain, syncing your circadian rhythm and shortening sleep latency, while scavenging free radicals. Perfectly dosed at just 1 mg." } },
        { "type": "ingredient", "settings": { "name": "Magnesium", "tags": "Recovery, Relaxation", "description": "An essential mineral and NMDA antagonist that calms the nervous system, eases muscle tension, and supports hundreds of enzymatic pathways tied to rest and recovery." } },
        { "type": "ingredient", "settings": { "name": "L-Theanine", "tags": "Calm focus, Alpha waves", "description": "An amino acid that promotes calming alpha brain-wave activity and relaxed alertness — easing you toward sleep without sedation." } },
        { "type": "ingredient", "settings": { "name": "Chamomile", "tags": "Calm, GABA support", "description": "An apigenin-rich botanical that gently engages GABA receptors to encourage natural calm and a settled mind before bed." } },
        { "type": "ingredient", "settings": { "name": "Lemon balm", "tags": "Mood, Deep sleep", "description": "A traditional calming herb that helps quiet mental chatter and supports deeper, more restorative sleep." } }
      ]
    }
  ]
}
{% endschema %}
